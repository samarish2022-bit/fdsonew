# Пароль панели администратора (обязательно смените)
ADMIN_PASSWORD=change-me-now

# Порт сервера (по умолчанию 3000)
# PORT=3000

# Время жизни токена сессии в миллисекундах (по умолчанию 12 часов)
# ADMIN_TOKEN_TTL_MS=43200000

# Разрешённый Origin для CORS, если админка открывается с другого домена
# ADMIN_CORS_ORIGIN=https://example.com
